# --- LLM gateway (9router) ---
# Local development reaches the gateway only through an SSH tunnel — see
# README.md "Local development against the gateway". Never point this at
# a public address.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=changeme
LLM_MODEL_FAST=solvia-fast
LLM_MODEL_SMART=solvia-smart

# --- Google adapter (only read when LLM_PROVIDER=google) ---
GOOGLE_VERTEXAI=false
GOOGLE_API_KEY=
GOOGLE_PROJECT=
GOOGLE_LOCATION=

# --- Database (Postgres checkpointer) ---
# Used directly by the API process; POSTGRES_* are used by docker-compose
# to configure the postgres service itself.
DATABASE_URL=postgresql://solvia:changeme@localhost:5432/solvia
POSTGRES_USER=solvia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=solvia

# --- Observability (optional) ---
# Leave blank to use the in-memory fake tracer locally (no network calls,
# no account required). Set both to send traces to LangFuse Cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
